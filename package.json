{
  "name": "vpered-finance",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "desktop": "electron .",
    "package:windows": "npm run build && electron-builder --win nsis --x64",
    "sync:mobile": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "description": "Offline personal budget calculator",
  "author": "Vpered",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.vpered.finance",
    "productName": "Vpered",
    "directories": {
      "output": "releases/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/app-icon.png",
      "package.json"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Vpered-Setup-${version}.${ext}"
    }
  }
}
